# DGS Sentinel AI environment configuration
# Copy this file to .env and replace placeholder values.
# Never commit the populated .env file.

# Application
APP_ENV=development
LOG_LEVEL=INFO
SESSION_TIMEOUT_MINUTES=30

# Authentication and RBAC
APP_USERNAME=administrator
APP_PASSWORD=replace-with-a-strong-password
DGS_APP_ROLE=Administrator

# AWS
AWS_REGION=us-east-1
AWS_PROFILE=default

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Axonius integration
AXONIUS_BASE_URL=
AXONIUS_API_KEY=
AXONIUS_API_SECRET=

# Application safety modes
DGS_PUBLIC_DEMO_MODE=false
DGS_LIVE_REMEDIATION_ENABLED=false

# Remediation evidence authentication
DGS_REMEDIATION_EVIDENCE_HMAC_KEY=
DGS_REMEDIATION_EVIDENCE_PREVIOUS_HMAC_KEYS=

# Optional client AssumeRole connection test
DGS_TEST_ROLE_ARN=
